# PayPal Sandbox REST app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
# Leave blank to run in clearly-labelled DEMO (mock) mode: no real Sandbox calls are made.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: LLM API key for receipt extraction assistance.
# The deterministic parser and explanation generator work fully without it.
LLM_API_KEY=
